{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ai-session-viewer-window",
  "description": "Permissions for the AI Session Viewer module window.",
  "windows": ["ai-session-viewer"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    "log:default",
    "ai-session-viewer:default"
  ]
}
